# 管理员账号（首次登录凭据）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 会话密钥（生产环境请改成随机字符串）
SECRET_KEY=please-change-me-to-a-random-secret

# API Key：留空即可，登录后可在「后台设置」里填写（存数据库，优先于这里的值）
DEEPSEEK_API_KEY=

# DeepSeek 配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 定时任务（cron 表达式，默认每天 06:00 北京时间）
SCHEDULE_CRON=0 6 * * *
TIMEZONE=Asia/Shanghai

# 数据/字体目录（Docker 中通常无需改动）
# DATA_DIR=./data
# FONT_DIR=./fonts
